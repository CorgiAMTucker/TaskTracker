generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum Role {
  ADMIN
  MEMBER
  REQUESTER
}

enum Priority {
  LOW
  MEDIUM
  HIGH
  URGENT
}

enum TaskSource {
  INTERNAL
  EXTERNAL_FORM
}

enum RequestKind {
  BROKER_REQUEST
  TASK
}

enum TaskKind {
  ENDORSEMENT
  CUSTOMER_QUESTION
  OTHER
}

model User {
  id           String   @id @default(cuid())
  name         String
  email        String   @unique
  passwordHash String
  role         Role     @default(MEMBER)
  createdAt    DateTime @default(now())

  managerId String?
  manager   User?   @relation("ManagerReports", fields: [managerId], references: [id])
  reports   User[]  @relation("ManagerReports")

  assignedTasks Task[] @relation("AssignedTasks")
  createdTasks  Task[] @relation("CreatedTasks")
  notes         Note[]

  roundRobinMemberships RoundRobinMember[]
}

model Board {
  id        String   @id @default(cuid())
  name      String
  order     Int
  createdAt DateTime @default(now())

  columns           Column[]
  roundRobinMembers RoundRobinMember[]
}

model Column {
  id    String @id @default(cuid())
  name  String
  order Int

  boardId String
  board   Board  @relation(fields: [boardId], references: [id], onDelete: Cascade)

  tasks Task[]

  @@index([boardId])
}

model Task {
  id          String      @id @default(cuid())
  title       String
  description String?
  priority    Priority    @default(MEDIUM)
  order       Int         @default(0)
  source      TaskSource  @default(INTERNAL)
  requestKind RequestKind @default(TASK)
  taskKind    TaskKind?

  columnId String
  column   Column @relation(fields: [columnId], references: [id])

  assigneeId String?
  assignee   User?   @relation("AssignedTasks", fields: [assigneeId], references: [id])

  createdById String?
  createdBy   User?   @relation("CreatedTasks", fields: [createdById], references: [id])

  requesterName      String?
  requesterFirstName String?
  requesterLastName  String?
  requesterEmail     String?
  requesterPhone     String?
  requesterCompany   String?

  entityFein            String?
  atlasLink             String?
  coverageRequested     String?
  limitsRequested       String?
  questionnaireFileUrl  String?
  questionnaireFileName String?

  notes Note[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([columnId])
  @@index([assigneeId])
}

model Note {
  id   String @id @default(cuid())
  body String

  taskId String
  task   Task   @relation(fields: [taskId], references: [id], onDelete: Cascade)

  authorId String
  author   User   @relation(fields: [authorId], references: [id])

  createdAt DateTime @default(now())

  @@index([taskId])
}

model RoundRobinMember {
  id     String  @id @default(cuid())
  order  Int
  active Boolean @default(true)

  boardId String
  board   Board  @relation(fields: [boardId], references: [id], onDelete: Cascade)

  userId String
  user   User   @relation(fields: [userId], references: [id])

  @@unique([boardId, userId])
}

model Setting {
  key   String @id
  value String
}
