generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum Role {
  ADMIN
  MEMBER
}

enum Priority {
  LOW
  MEDIUM
  HIGH
  URGENT
}

enum TaskSource {
  INTERNAL
  EXTERNAL_FORM
}

model User {
  id           String   @id @default(cuid())
  name         String
  email        String   @unique
  passwordHash String
  role         Role     @default(MEMBER)
  createdAt    DateTime @default(now())

  managerId String?
  manager   User?   @relation("ManagerReports", fields: [managerId], references: [id])
  reports   User[]  @relation("ManagerReports")

  assignedTasks Task[] @relation("AssignedTasks")
  createdTasks  Task[] @relation("CreatedTasks")

  roundRobinMemberships RoundRobinMember[]
}

model Board {
  id        String   @id @default(cuid())
  name      String
  order     Int
  createdAt DateTime @default(now())

  columns           Column[]
  roundRobinMembers RoundRobinMember[]
}

model Column {
  id      String @id @default(cuid())
  name    String
  order   Int

  boardId String
  board   Board  @relation(fields: [boardId], references: [id], onDelete: Cascade)

  tasks Task[]

  @@index([boardId])
}

model Task {
  id          String     @id @default(cuid())
  title       String
  description String?
  priority    Priority   @default(MEDIUM)
  order       Int        @default(0)
  source      TaskSource @default(INTERNAL)

  columnId String
  column   Column @relation(fields: [columnId], references: [id])

  assigneeId String?
  assignee   User?   @relation("AssignedTasks", fields: [assigneeId], references: [id])

  createdById String?
  createdBy   User?   @relation("CreatedTasks", fields: [createdById], references: [id])

  requesterName    String?
  requesterEmail   String?
  requesterCompany String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([columnId])
  @@index([assigneeId])
}

model RoundRobinMember {
  id      String  @id @default(cuid())
  order   Int
  active  Boolean @default(true)

  boardId String
  board   Board  @relation(fields: [boardId], references: [id], onDelete: Cascade)

  userId String
  user   User   @relation(fields: [userId], references: [id])

  @@unique([boardId, userId])
}

model Setting {
  key   String @id
  value String
}
