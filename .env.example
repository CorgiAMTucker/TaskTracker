# Postgres connection string (from Vercel Postgres / Neon dashboard, or any Postgres host).
DATABASE_URL="postgresql://user:password@host:5432/dbname"

# Random secret used to sign login sessions. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
AUTH_SECRET="replace-with-a-random-64-character-hex-string"
